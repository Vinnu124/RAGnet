# Copy to .env and edit. Every setting in ragnet/config.py can be set as RAGNET_<NAME>.

# --- LLM server (OpenAI-compatible). Pick ONE of the presets below. ---
# vLLM (recommended on a GPU box)
RAGNET_LLM_BASE_URL=http://localhost:8000/v1
RAGNET_LLM_MODEL=Qwen/Qwen3-32B
# Ollama
# RAGNET_LLM_BASE_URL=http://localhost:11434/v1
# RAGNET_LLM_MODEL=qwen3:32b

# Optional smaller/faster model for routing, chunk contexts and verification (must be served by the same endpoint)
# RAGNET_ROUTER_MODEL=Qwen/Qwen3-8B

RAGNET_LLM_CONTEXT_WINDOW=32768
RAGNET_LLM_MAX_TOKENS=2048
RAGNET_LLM_CONCURRENCY=8

# --- Embeddings / reranker (loaded in-process, GPU auto-detected) ---
RAGNET_EMBED_MODEL=BAAI/bge-m3
RAGNET_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAGNET_DEVICE=auto

# --- Vector store: embedded local Qdrant by default. Set a URL to use a server instead. ---
# RAGNET_QDRANT_URL=http://localhost:6333
RAGNET_DATA_DIR=data

# --- Retrieval / answering ---
RAGNET_CHUNK_TOKENS=400
RAGNET_PREFETCH_K=40
RAGNET_TOP_K=6
RAGNET_CONTEXTUAL=false          # true = LLM writes a context line per chunk at ingest (slower ingest, better recall)
RAGNET_VERIFY=true               # post-hoc citation verification
RAGNET_LONG_CONTEXT_MAX_TOKENS=40000
